<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Yardstick report: {{ run.suite_name }}</title>
<style>
:root { --bg: #ffffff; --fg: #1d2129; --muted: #5b6270; --line: #d9dde3; --panel: #f5f7fa;
  --bar: #3b6fd8; --base: #1d2129; --track: #e9edf2; --pass: #1f7a3f; --fail: #b3261e; --warn-bg: #fff4d6; }
@media (prefers-color-scheme: dark) {
  :root { --bg: #14171c; --fg: #e6e8eb; --muted: #9aa2ad; --line: #2c323b; --panel: #1b1f26;
    --bar: #7aa2ff; --base: #e6e8eb; --track: #262c35; --pass: #5cc483; --fail: #ff8a80; --warn-bg: #3a3218; }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--fg);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
main { max-width: 960px; margin: 0 auto; padding: 24px 16px 48px; }
h1 { font-size: 1.5rem; margin: 0 0 4px; }
h2 { font-size: 1.15rem; margin: 32px 0 8px; border-bottom: 1px solid var(--line); padding-bottom: 4px; }
code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9em; overflow-wrap: break-word; }
td.rule code { white-space: nowrap; }
.badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-weight: 600; color: var(--bg); }
.badge.pass { background: var(--pass); } .badge.fail { background: var(--fail); }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; margin: 8px 0; }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { color: var(--muted); font-weight: 600; font-size: 0.85rem; }
td.num { font-variant-numeric: tabular-nums; white-space: nowrap; }
.fail-text { color: var(--fail); font-weight: 600; } .pass-text { color: var(--pass); }
.warn { background: var(--warn-bg); padding: 8px 12px; border-radius: 6px; margin: 8px 0; }
.muted { color: var(--muted); }
figure { margin: 12px 0; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 12px; }
figcaption { font-weight: 600; margin-bottom: 6px; }
svg { width: 100%; height: auto; display: block; }
svg text { fill: var(--fg); font-size: 13px; font-family: inherit; }
svg .track { fill: var(--track); } svg .bar { fill: var(--bar); }
svg .base { stroke: var(--base); stroke-width: 2; }
.legend { font-size: 0.85rem; color: var(--muted); margin-top: 4px; }
details summary { cursor: pointer; color: var(--muted); }
footer { margin-top: 40px; font-size: 0.85rem; color: var(--muted); }
</style>
</head>
<body>
<main>
<h1>Yardstick report: {{ run.suite_name }}</h1>
{% if gate %}
<p>{% if gate.passed %}<span class="badge pass">Gate passed</span>{% else %}<span class="badge fail">Gate failed</span>{% endif %}</p>
{% endif %}
<div class="table-wrap"><table>
<tr><th>Run</th><td><code>{{ run.run_id }}</code></td></tr>
<tr><th>Suite</th><td><code>{{ run.suite_name }}</code> (<code>{{ run.suite_hash[:19] }}</code>)</td></tr>
<tr><th>Target</th><td><code>{{ run.target.name }}</code> ({{ run.target.kind }})</td></tr>
<tr><th>Model</th><td>{{ run.model or NOT_REPORTED }}</td></tr>
<tr><th>Prompt hash</th><td>{{ run.prompt_hash or NOT_REPORTED }}</td></tr>
<tr><th>Git SHA</th><td>{{ run.git_sha or NOT_REPORTED }}</td></tr>
<tr><th>Started</th><td>{{ run.started_at }}</td></tr>
<tr><th>Items</th><td>{{ m.n_items }} ({{ m.n_errors }} target error{{ "" if m.n_errors == 1 else "s" }}{% if m.n_not_scored %}, {{ m.n_not_scored }} not scored{% endif %})</td></tr>
{% if baseline %}<tr><th>Baseline</th><td><code>{{ baseline.run_id }}</code> (<code>{{ baseline.target.name }}</code>)</td></tr>
{% endif %}
</table></div>
{% for w in warnings %}
<p class="warn"><strong>Warning:</strong> {{ w }}</p>
{% endfor %}

<h2>Summary</h2>
<div class="table-wrap"><table>
<tr><th>Metric</th><th>Value</th>{% if comparison %}<th>Baseline</th><th>Change</th>{% endif %}</tr>
{% for row in summary_rows %}
<tr><td>{{ row.label }}</td><td class="num">{{ row.value }}</td>{% if comparison %}<td class="num">{{ row.base }}</td><td class="num">{{ row.delta }}</td>{% endif %}</tr>
{% endfor %}
</table></div>

{% for chart in charts %}
<figure>
<figcaption>{{ chart.title }}</figcaption>
<svg viewBox="0 0 {{ W }} {{ chart.height }}" role="img" aria-label="{{ chart.title }}">
{% for bar in chart.bars %}
{% set y = loop.index0 * RH + 4 %}
<text x="0" y="{{ y + 16 }}">{{ bar.label[:30] }}</text>
<rect class="track" x="{{ LW }}" y="{{ y + 3 }}" width="{{ bar.plot_width }}" height="16" rx="3"></rect>
{% if bar.value is not none %}<rect class="bar" x="{{ LW }}" y="{{ y + 3 }}" width="{{ bar.width() }}" height="16" rx="3"></rect>{% endif %}
{% if bar.base_x() is not none %}<line class="base" x1="{{ bar.base_x() }}" x2="{{ bar.base_x() }}" y1="{{ y }}" y2="{{ y + 22 }}"></line>{% endif %}
<text x="{{ W - VW + 8 }}" y="{{ y + 16 }}">{{ bar.text }}</text>
{% endfor %}
</svg>
<div class="legend">Bar: this run.{% if chart.has_baseline %} Line: baseline.{% endif %} Scale 0–100%.</div>
</figure>
{% endfor %}

{% if rate_rows %}
<h2>Rates</h2>
<p class="muted">Per scorer: hits / total over the items it applied to. Report-only scorers never decide an item's pass.</p>
<div class="table-wrap"><table>
<tr><th>Scorer</th><th>Items</th><th>Rate</th>{% if comparison %}<th>Baseline</th><th>Change</th>{% endif %}</tr>
{% for row in rate_rows %}
<tr><td><code>{{ row.label }}</code></td><td class="num">{{ row.n }}</td><td class="num">{{ row.value }}</td>{% if comparison %}<td class="num">{{ row.base }}</td><td class="num">{{ row.delta }}</td>{% endif %}</tr>
{% endfor %}
</table></div>
{% endif %}

{% if slice_rows %}
<h2>Slices</h2>
<div class="table-wrap"><table>
<tr><th>Slice</th><th>Items</th><th>Pass rate</th><th>Mean score</th>{% if comparison %}<th>Pass rate change</th>{% endif %}</tr>
{% for row in slice_rows %}
<tr><td>{{ row.name }}</td><td class="num">{{ row.n }}</td><td class="num">{{ row.pass_rate }}</td><td class="num">{{ row.mean }}</td>{% if comparison %}<td class="num">{{ row.delta }}</td>{% endif %}</tr>
{% endfor %}
</table></div>
{% endif %}

{% if slice_rate_rows %}
<details>
<summary>Rates by slice ({{ slice_rate_rows | length }} rows)</summary>
<div class="table-wrap"><table>
<tr><th>Slice</th><th>Scorer</th><th>Items</th><th>Rate</th>{% if comparison %}<th>Change</th>{% endif %}</tr>
{% for row in slice_rate_rows %}
<tr><td>{{ row.slice }}</td><td><code>{{ row.label }}</code></td><td class="num">{{ row.n }}</td><td class="num">{{ row.value }}</td>{% if comparison %}<td class="num">{{ row.delta }}</td>{% endif %}</tr>
{% endfor %}
</table></div>
</details>
{% endif %}

{% if run.judges %}
<h2>Judges</h2>
<p>LLM-judge scores are report-only per item; a gate rule on a judge rate gates only if the judge's kappa clears the floor (YS-05).</p>
<div class="table-wrap"><table>
<tr><th>Scorer</th><th>Judge</th><th>Prompt hash</th><th>Units judged</th><th>No valid label</th><th>Not judged (budget)</th><th>Calls</th><th>Spend / cap (run)</th></tr>
{% for key, j in run.judges.items() %}
<tr><td><code>{{ key }}</code></td><td>{{ j.model }} ({{ j.source }})</td><td><code>{{ j.prompt_hash }}</code></td><td class="num">{{ j.units_judged }}</td><td class="num">{{ j.units_invalid }}</td><td class="num">{{ j.units_skipped_budget }}</td><td class="num">{{ j.calls }}</td><td class="num">${{ "%.6f" | format(j.spent_usd) }} / ${{ "%.6f" | format(j.cap_usd) }}{{ " (over estimate)" if j.overrun }}</td></tr>
{% endfor %}
</table></div>
{% endif %}
{% if gate %}
<h2>Gate</h2>
<div class="table-wrap"><table>
<tr><th>Rule</th><th>Current</th><th>Baseline</th><th>Items</th><th>Checks</th><th>Result</th></tr>
{% for row in gate_rows %}
<tr><td class="rule"><code>{{ row.label }}</code></td><td class="num">{{ row.current }}</td><td class="num">{{ row.base }}</td><td class="num">{{ row.n }} / min {{ row.min }}</td><td>{% for c in row.checks %}{{ c }}{% if not loop.last %}<br>{% endif %}{% endfor %}</td><td>{% if row.report_only %}report-only: {{ "pass" if row.passed else "fail" }}{% elif row.passed %}<span class="pass-text">pass</span>{% else %}<span class="fail-text">FAIL</span>{% endif %}</td></tr>
{% endfor %}
</table></div>
{% endif %}

{% if comparison and (comparison.newly_failing or comparison.newly_passing) %}
<h2>Item changes vs baseline</h2>
<ul>
{% if comparison.newly_failing %}<li>Newly failing ({{ comparison.newly_failing | length }}): {% for i in comparison.newly_failing %}<code>{{ i }}</code>{{ ", " if not loop.last }}{% endfor %}</li>
{% endif %}
{% if comparison.newly_passing %}<li>Newly passing ({{ comparison.newly_passing | length }}): {% for i in comparison.newly_passing %}<code>{{ i }}</code>{{ ", " if not loop.last }}{% endfor %}</li>
{% endif %}
</ul>
{% endif %}

{% if failing_rows %}
<h2>Failing items{% if failing_more %} (first {{ failing_rows | length }} of {{ failing_total }}){% endif %}</h2>
<div class="table-wrap"><table>
<tr><th>Item</th><th>Slices</th><th>Failed checks</th></tr>
{% for row in failing_rows %}
<tr><td><code>{{ row.id }}</code></td><td>{{ row.slices }}</td><td>{{ row.detail }}</td></tr>
{% endfor %}
</table></div>
{% endif %}
{% if not_scored %}
<h2>Not scored ({{ m.n_not_scored }})</h2>
<p>Items with no gating scorer (only report-only scores), so they are left out of pass rate and mean score: {% for i in not_scored %}<code>{{ i }}</code>{{ ", " if not loop.last }}{% endfor %}{{ ", …" if m.n_not_scored > not_scored | length }}</p>
{% endif %}

<footer>Generated by Yardstick {{ version }}. Cost in USD; latency in integer ms; "not reported" means the target did not report it. Single static file: no scripts, no external resources.</footer>
</main>
</body>
</html>
