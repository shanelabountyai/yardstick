<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Yardstick report: {{ run.suite_name }}</title>
<style>
:root { color-scheme: light dark;
  --bg: #ffffff; --fg: #1d2129; --muted: #5b6270; --line: #d9dde3; --panel: #f5f7fa;
  --bar: #3b6fd8; --base: #1d2129; --track: #e9edf2; --track-line: #848c99;
  --pass: #1f7a3f; --fail: #b3261e; --warn-bg: #fff4d6; }
@media (prefers-color-scheme: dark) {
  :root { --bg: #14171c; --fg: #e6e8eb; --muted: #9aa2ad; --line: #2c323b; --panel: #1b1f26;
    --bar: #7aa2ff; --base: #e6e8eb; --track: #262c35; --track-line: #6e7785;
    --pass: #5cc483; --fail: #ff8a80; --warn-bg: #3a3218; }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--fg);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
main, footer { max-width: 960px; margin: 0 auto; padding: 24px 16px 0; }
main { padding-bottom: 8px; }
footer { padding-bottom: 48px; font-size: 0.85rem; color: var(--muted); }
h1 { font-size: 1.5rem; margin: 0 0 4px; }
h2 { font-size: 1.15rem; margin: 32px 0 8px; border-bottom: 1px solid var(--line); padding-bottom: 4px; }
code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9em; overflow-wrap: break-word; }
th.rule code, td.rule code { white-space: nowrap; }
.badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-weight: 600; color: var(--bg); }
.badge.pass { background: var(--pass); } .badge.fail { background: var(--fail); }
/* Wide tables scroll inside a named, focusable region (the key column, Result, comes second). */
.table-wrap { overflow-x: auto; }
.table-wrap:focus-visible, summary:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
table { border-collapse: collapse; width: 100%; margin: 8px 0; }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
thead th { color: var(--muted); font-weight: 600; font-size: 0.85rem; }
tbody th { font-weight: 400; }
td.num { font-variant-numeric: tabular-nums; white-space: nowrap; }
.fail-text { color: var(--fail); font-weight: 600; } .pass-text { color: var(--pass); }
.warn { background: var(--warn-bg); padding: 8px 12px; border-radius: 6px; margin: 8px 0; }
.muted, .note { color: var(--muted); } .small { font-size: 0.85rem; }
.why { margin: 8px 0; padding-left: 20px; }
dl.key { display: grid; grid-template-columns: max-content 1fr; gap: 4px 12px; margin: 8px 0; }
dl.key dt { font-weight: 600; } dl.key dd { margin: 0; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
/* Charts are HTML rows (D-90): text stays at the page's size at any width or zoom. */
figure.chart { margin: 12px 0; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 12px; }
figure.chart figcaption { font-weight: 600; margin-bottom: 6px; }
.chart ul { list-style: none; margin: 0; padding: 0; display: grid;
  grid-template-columns: minmax(4ch, max-content) minmax(80px, 1fr) max-content; gap: 6px 12px; align-items: center; }
.chart li { display: contents; }
.chart .label { overflow-wrap: break-word; max-width: 28ch; }
.chart .track { position: relative; height: 16px; background: var(--track); border: 1px solid var(--track-line); border-radius: 3px; }
.chart .track.nr { background: transparent; border-style: dashed; }
.chart .bar { position: absolute; left: 0; top: 0; bottom: 0; background: var(--bar); border-radius: 2px; }
.chart .bar.zero { width: 2px !important; }
.chart .base { position: absolute; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; background: var(--base);
  box-shadow: 0 0 0 2px var(--panel); }
.chart .value { font-variant-numeric: tabular-nums; white-space: nowrap; }
.chart .ro { color: var(--muted); } .chart .ro + .track .bar { opacity: 0.55; }
.legend { font-size: 0.85rem; color: var(--muted); margin-top: 8px; }
.legend .swatch { display: inline-block; width: 2px; height: 12px; background: var(--base); vertical-align: middle; margin: 0 4px; }
details summary { cursor: pointer; color: var(--muted); }
details summary h3 { display: inline; font-size: 1rem; font-weight: 600; margin: 0; }
@media print {
  .badge { background: none !important; color: var(--fail); border: 1.5px solid currentColor; }
  .badge.pass { color: var(--pass); }
  .chart .bar, .chart .base, .chart .track { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
  figure, tr { break-inside: avoid; }
  .table-wrap { overflow: visible; }
}
</style>
</head>
<body>
<main>
<h1>Yardstick report: {{ run.suite_name }}</h1>
{% if gate %}
<p>{% if gate.passed %}<span class="badge pass">Gate passed</span>{% else %}<span class="badge fail">Gate failed</span>{% endif %}</p>
{% endif %}
{% if why %}
<ul class="why">
{% for label, text in why %}<li><code>{{ label }}</code>: {{ text }}</li>
{% endfor %}
</ul>
{% endif %}
{% if cross_target %}
<p class="note">Compared against a different target: <code>{{ cross_target }}</code>. Each change is this target against that one, not a before and after.</p>
{% endif %}
{% for w in warnings %}
<p class="warn"><strong>Warning:</strong> {{ w }}</p>
{% endfor %}

<h2 id="h-summary">Summary</h2>
<div class="table-wrap" role="region" tabindex="0" aria-labelledby="h-summary"><table aria-labelledby="h-summary">
<thead><tr><th scope="col">Metric</th><th scope="col">Value</th>{% if comparison %}<th scope="col">Baseline</th><th scope="col">Change</th>{% endif %}</tr></thead>
<tbody>
{% for row in summary_rows if not (hide_mean and row.label == "Mean score") %}
<tr><th scope="row">{{ row.label }}</th><td class="num">{{ row.value }}</td>{% if comparison %}<td class="num">{{ row.base }}</td><td class="num">{{ row.delta }}</td>{% endif %}</tr>
{% endfor %}
</tbody>
</table></div>
{% if hide_mean %}<p class="muted small">Mean score equals pass rate in every row here (every scorer is pass or fail), so it is not shown.</p>{% endif %}

{% if key_scorers or key_slices %}
<h2 id="h-key">Key</h2>
<dl class="key">
{% for k, v in key_scorers %}<dt><code>{{ k }}</code></dt><dd>{{ v }}</dd>
{% endfor %}
{% for k, v in key_slices %}<dt>slice <code>{{ k }}</code></dt><dd>{{ v }}</dd>
{% endfor %}
</dl>
{% endif %}

{% if gate %}
<h2 id="h-gate">Gate</h2>
<div class="table-wrap" role="region" tabindex="0" aria-labelledby="h-gate"><table aria-labelledby="h-gate">
<thead><tr><th scope="col">Rule</th><th scope="col">Result</th><th scope="col">Current</th><th scope="col">Baseline</th><th scope="col">Items</th><th scope="col">Checks</th></tr></thead>
<tbody>
{% for row in gate_rows %}
<tr><th scope="row" class="rule"><code>{{ row.label }}</code></th><td>{% if row.report_only %}<span class="muted">report-only: {{ "pass" if row.passed else "fail" }}</span>{% elif row.passed %}<span class="pass-text">pass</span>{% else %}<span class="fail-text">FAIL</span>{% endif %}</td><td class="num">{{ row.current }}</td><td class="num">{{ row.base }}</td><td class="num">{{ row.n }} / min {{ row.min }}</td><td>{% for c in row.checks %}{{ c }}{% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>
{% endfor %}
</tbody>
</table></div>
{% endif %}

{% macro chart_figure(chart, idx) %}
<figure class="chart" aria-labelledby="chart-{{ idx }}">
<figcaption id="chart-{{ idx }}">{{ chart.title }}</figcaption>
<ul>
{% for bar in chart.bars %}
<li><span class="label{{ ' ro' if bar.report_only }}">{{ bar.label }}</span><span class="track{{ ' nr' if bar.value is none }}" aria-hidden="true">{% if bar.value is not none %}<span class="bar{{ ' zero' if bar.value == 0 }}" style="width: {{ bar.pct }}%"></span>{% endif %}{% if bar.value is not none and bar.baseline is not none %}<span class="base" style="left: {{ bar.base_pct }}%"></span>{% endif %}</span><span class="value">{{ bar.text }}{% if bar.baseline is not none %}<span class="sr">, baseline {{ bar.base_text }}</span>{% endif %}</span></li>
{% endfor %}
</ul>
<div class="legend">Bar: this run.{% if chart.has_baseline %} <span class="swatch" aria-hidden="true"></span>Line: baseline.{% endif %} Scale 0–100%. A dashed track is "not reported".</div>
</figure>
{% endmacro %}

{% if slice_rows %}
<h2 id="h-slices">Slices</h2>
{% for chart in charts if chart.kind == "slices" %}{{ chart_figure(chart, 1) }}{% endfor %}
<div class="table-wrap" role="region" tabindex="0" aria-labelledby="h-slices"><table aria-labelledby="h-slices">
<thead><tr><th scope="col">Slice</th><th scope="col">Items</th><th scope="col">Pass rate</th>{% if not hide_mean %}<th scope="col">Mean score</th>{% endif %}{% if comparison %}<th scope="col">Pass rate change</th>{% endif %}</tr></thead>
<tbody>
{% for row in slice_rows %}
<tr><th scope="row">{{ row.name }}</th><td class="num">{{ row.n }}</td><td class="num">{{ row.pass_rate }}</td>{% if not hide_mean %}<td class="num">{{ row.mean }}</td>{% endif %}{% if comparison %}<td class="num">{{ row.delta }}</td>{% endif %}</tr>
{% endfor %}
</tbody>
</table></div>
{% endif %}

{% if rate_rows %}
<h2 id="h-rates">Rates</h2>
<p class="muted">Per scorer: hits / total over the items it applied to. Report-only scorers never decide an item's pass.</p>
{% for chart in charts if chart.kind == "rates" %}{{ chart_figure(chart, 2) }}{% endfor %}
<div class="table-wrap" role="region" tabindex="0" aria-labelledby="h-rates"><table aria-labelledby="h-rates">
<thead><tr><th scope="col">Scorer</th><th scope="col">Items</th><th scope="col">Rate</th>{% if comparison %}<th scope="col">Baseline</th><th scope="col">Change</th>{% endif %}</tr></thead>
<tbody>
{% for row in rate_rows %}
<tr><th scope="row"><code>{{ row.label }}</code></th><td class="num">{{ row.n }}</td><td class="num">{{ row.value }}</td>{% if comparison %}<td class="num">{{ row.base }}</td><td class="num">{{ row.delta }}</td>{% endif %}</tr>
{% endfor %}
</tbody>
</table></div>
{% endif %}

{% if slice_rate_rows %}
<details>
<summary><h3 id="h-slice-rates">Rates by slice ({{ slice_rate_rows | length }} rows)</h3></summary>
<div class="table-wrap" role="region" tabindex="0" aria-labelledby="h-slice-rates"><table aria-labelledby="h-slice-rates">
<thead><tr><th scope="col">Slice</th><th scope="col">Scorer</th><th scope="col">Items</th><th scope="col">Rate</th>{% if comparison %}<th scope="col">Change</th>{% endif %}</tr></thead>
<tbody>
{% for row in slice_rate_rows %}
<tr><th scope="row">{{ row.slice }}</th><td><code>{{ row.label }}</code></td><td class="num">{{ row.n }}</td><td class="num">{{ row.value }}</td>{% if comparison %}<td class="num">{{ row.delta }}</td>{% endif %}</tr>
{% endfor %}
</tbody>
</table></div>
</details>
{% endif %}

{% if run.judges %}
<h2 id="h-judges">Judges</h2>
<p>LLM-judge scores are report-only per item; a gate rule on a judge rate gates only if the judge's kappa clears the floor (YS-05).</p>
<div class="table-wrap" role="region" tabindex="0" aria-labelledby="h-judges"><table aria-labelledby="h-judges">
<thead><tr><th scope="col">Scorer</th><th scope="col">Judge</th><th scope="col">Prompt hash</th><th scope="col">Units judged</th><th scope="col">No valid label</th><th scope="col">Not judged (budget)</th><th scope="col">Calls</th><th scope="col">Spend / cap (run)</th></tr></thead>
<tbody>
{% for key, j in run.judges.items() %}
<tr><th scope="row"><code>{{ key }}</code></th><td>{{ j.model }}, {{ j.source.split(" ", 1)[0] }}<br><span class="muted small">{{ j.source }}</span></td><td><code>{{ j.prompt_hash }}</code></td><td class="num">{{ j.units_judged }}</td><td class="num">{{ j.units_invalid }}</td><td class="num">{{ j.units_skipped_budget }}</td><td class="num">{{ j.calls }}</td><td class="num">{% if j.spent_usd == 0 and j.cap_usd == 0 %}$0 (no paid calls){% else %}${{ "%.6f" | format(j.spent_usd) }} / ${{ "%.6f" | format(j.cap_usd) }}{% endif %}{{ " (over estimate)" if j.overrun }}</td></tr>
{% endfor %}
</tbody>
</table></div>
{% endif %}

<h2 id="h-run">Run</h2>
<div class="table-wrap" role="region" tabindex="0" aria-labelledby="h-run"><table aria-labelledby="h-run">
<tbody>
<tr><th scope="row">Run</th><td><code>{{ run.run_id }}</code></td></tr>
<tr><th scope="row">Suite</th><td><code>{{ run.suite_name }}</code> (<code>{{ run.suite_hash[:19] }}</code>)</td></tr>
<tr><th scope="row">Target</th><td><code>{{ run.target.name }}</code> ({{ run.target.kind }})</td></tr>
<tr><th scope="row">Model</th><td>{{ run.model or NOT_REPORTED }}</td></tr>
<tr><th scope="row">Prompt hash</th><td>{{ run.prompt_hash or NOT_REPORTED }}</td></tr>
<tr><th scope="row">Git SHA</th><td>{{ run.git_sha or NOT_REPORTED }}</td></tr>
<tr><th scope="row">Started</th><td>{{ run.started_at }}</td></tr>
<tr><th scope="row">Items</th><td>{{ m.n_items }} ({{ m.n_errors }} target error{{ "" if m.n_errors == 1 else "s" }}{% if m.n_not_scored %}, {{ m.n_not_scored }} not scored{% endif %})</td></tr>
{% if baseline %}<tr><th scope="row">Baseline</th><td><code>{{ baseline.run_id }}</code> (<code>{{ baseline.target.name }}</code>)</td></tr>
{% endif %}
</tbody>
</table></div>

{% if comparison and (comparison.newly_failing or comparison.newly_passing) %}
<h2>Item changes vs baseline</h2>
<ul>
{% if comparison.newly_failing %}<li>Newly failing ({{ comparison.newly_failing | length }}): {% for i in comparison.newly_failing %}<code>{{ i }}</code>{{ ", " if not loop.last }}{% endfor %}</li>
{% endif %}
{% if comparison.newly_passing %}<li>Newly passing ({{ comparison.newly_passing | length }}): {% for i in comparison.newly_passing %}<code>{{ i }}</code>{{ ", " if not loop.last }}{% endfor %}</li>
{% endif %}
</ul>
{% endif %}

{% if failing_rows %}
<h2 id="h-failing">Failing items{% if failing_more %} (first {{ failing_rows | length }} of {{ failing_total }}){% endif %}</h2>
<div class="table-wrap" role="region" tabindex="0" aria-labelledby="h-failing"><table aria-labelledby="h-failing">
<thead><tr><th scope="col">Item</th><th scope="col">Slices</th><th scope="col">Failed checks</th></tr></thead>
<tbody>
{% for row in failing_rows %}
<tr><th scope="row"><code>{{ row.id }}</code></th><td>{{ row.slices }}</td><td>{{ row.detail }}</td></tr>
{% endfor %}
</tbody>
</table></div>
{% endif %}
{% if not_scored %}
<h2>Not scored ({{ m.n_not_scored }})</h2>
<p>Items with no gating scorer (only report-only scores), so they are left out of pass rate and mean score: {% for i in not_scored %}<code>{{ i }}</code>{{ ", " if not loop.last }}{% endfor %}{{ ", …" if m.n_not_scored > not_scored | length }}</p>
{% endif %}
</main>
<footer>Generated by Yardstick {{ version }}. Cost in USD; latency in integer ms; "not reported" means the target did not report it. Single static file: no scripts, no external resources.</footer>
</body>
</html>
